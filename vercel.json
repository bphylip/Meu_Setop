{
    "cleanUrls": true,
    "trailingSlash": false,
  
    "redirects": [
  
      {
        "source": "/src/pages/index.html",
        "destination": "/",
        "statusCode": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "statusCode": 301
      },
  
      {
        "source": "/src/pages/ofertas.html",
        "destination": "/ofertas",
        "statusCode": 301
      },
      {
        "source": "/src/pages/articles.html",
        "destination": "/articles",
        "statusCode": 301
      },
  

  
      {
        "source": "/src/pages/:path*",
        "destination": "/:path*",
        "permanent": true
      },
  

  
      {
        "source": "/ofertas.html",
        "destination": "/ofertas",
        "statusCode": 301
      },
      {
        "source": "/articles.html",
        "destination": "/articles",
        "statusCode": 301
      },
  
      {
        "source": "/posts/:slug.html",
        "destination": "/posts/:slug",
        "statusCode": 301
      }


    ]
  }
  